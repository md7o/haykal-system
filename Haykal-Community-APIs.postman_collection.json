          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello World - Updated\",\n  \"content\": \"Updated content\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/community/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["community", "posts", "{{postId}}"]
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/community/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["community", "posts", "{{postId}}"]
            }
          }
        }
      ]
    },
